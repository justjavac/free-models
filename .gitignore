# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# WorkBuddy project memory (internal, not source)
.workbuddy/

# typescript
*.tsbuildinfo
next-env.d.ts

# 数据端点由 src/app 路由静态生成，public 下不再跟踪
/public/api.json
/public/models.json
/public/catalog.json
/public/llms.txt
/public/llms-full.txt
/scripts/
